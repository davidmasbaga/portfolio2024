---
---

<div class="weather-container">
  <div id="weatherDisplay" aria-live="polite"></div>

  <svg class="circles" width="900" height="900" viewBox="0 0 200 200">
    <circle
      cx="100"
      cy="100"
      r="90"
      stroke="gray"
      stroke-width="0.1"
      fill="none"
    ></circle>
    <circle
      cx="80"
      cy="60"
      r="50"
      stroke="gray"
      stroke-width="0.5"
      fill="none"
    ></circle>
    <circle
      cx="120"
      cy="80"
      r="60"
      stroke="#c8ff00"
      stroke-width="0.3"
      fill="none"
    ></circle>
  </svg>
</div>

<script>
  function kelvinToCelsius(kelvin) {
    const celsius = kelvin - 273.15;
    return celsius.toFixed(1);
  }

  function updateHour() {
    const currentHour = document.getElementById("currentHour");
    if (!currentHour) return;

    const now = new Date();
    const hour = now.getHours();
    const minutes = now.getMinutes();
    const hourStr = hour < 10 ? `0${hour}` : `${hour}`;
    const minutesStr = minutes < 10 ? `0${minutes}` : `${minutes}`;

    currentHour.textContent = `${hourStr}:${minutesStr}h`;
  }

  async function fetchWeatherData() {
    try {
      const apiWeather = import.meta.env.PUBLIC_URL_API_WEATHER;
      const response = await fetch(apiWeather);
      const weatherData = await response.json();

      if (!response.ok) {
        throw new Error(weatherData?.error || "Error fetching weather data");
      }

      const weatherContainer = document.getElementById("weatherDisplay");
      if (!weatherContainer) return;

      weatherContainer.innerHTML = `
        <div>
          <p class="serif xl:text-8xl tracking-normal mb-2">Barcelona</p>
          <div class="flex gap-4">
            <p class="serif xl:text-4xl">${kelvinToCelsius(weatherData.main.temp)}º</p>
            <p class="serif xl:text-4xl text-accent">Sky ${weatherData.weather[0].main}</p>
            <p class="serif xl:text-5xl" id="currentHour"></p>
          </div>
        </div>
      `;

      updateHour();
    } catch (error) {
      console.error("Error fetching weather data:", error);
    }
  }

  fetchWeatherData();
  setInterval(updateHour, 60000);
</script>

<style>
  .weather-container {
    position: relative;
  }

  .circles {
    position: absolute;
    top: 50%;
    right: 50%;
    transform: translate(80%, -70%);
    z-index: -10;
  }

  @media (max-width: 1279px) {
    .weather-container {
      display: none;
    }
  }
</style>
